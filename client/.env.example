# Game server URL baked into client builds (on Vercel, set it in the project's env settings).
# Leave it empty for local dev: the client then uses port 2567 on the page's own host,
# which also works for phones on your Wi-Fi.
# Examples:
#   VITE_SERVER_URL=https://abc-123.trycloudflare.com
#   VITE_SERVER_URL=https://game.example.com
VITE_SERVER_URL=
